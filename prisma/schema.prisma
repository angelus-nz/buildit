generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth required tables) ────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users ──────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  TRADESMAN
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  business   Business?
  reviews    Review[]  @relation("ReviewAuthor")
  quotes     Quote[]   @relation("QuoteCustomer")
  inquiries  Inquiry[] @relation("InquiryCustomer")
}

// ─── Business Profiles ──────────────────────────────────────────────────────

enum BusinessCategory {
  PLUMBING
  ELECTRICAL
  CARPENTRY
  PAINTING
  ROOFING
  LANDSCAPING
  HVAC
  MASONRY
  TILING
  GENERAL
  OTHER
}

model Business {
  id          String           @id @default(cuid())
  userId      String           @unique
  name        String
  slug        String           @unique
  bio         String?          @db.Text
  phone       String?
  website     String?
  category    BusinessCategory @default(OTHER)
  suburb      String?
  city        String?
  state       String?
  country     String           @default("NZ")
  logoUrl     String?
  coverUrl    String?
  isVerified  Boolean          @default(false)
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]
  reviews   Review[]
  quotes    Quote[]
  invoices  Invoice[]
  inquiries Inquiry[]
}

// ─── Projects (work showcase) ────────────────────────────────────────────────

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
}

model Project {
  id          String        @id @default(cuid())
  businessId  String
  title       String
  description String?       @db.Text
  status      ProjectStatus @default(IN_PROGRESS)
  isPublic    Boolean       @default(true)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updates  ProjectUpdate[]
  images   ProjectImage[]
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photos  ProjectImage[]
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  updateId  String?
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  update  ProjectUpdate? @relation(fields: [updateId], references: [id], onDelete: SetNull)
}

// ─── Reviews ────────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  businessId String
  authorId   String
  rating     Int
  body       String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author   User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([businessId, authorId])
}

// ─── Quotes ──────────────────────────────────────────────────────────────────

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model Quote {
  id          String      @id @default(cuid())
  businessId  String
  customerId  String
  title       String
  description String?     @db.Text
  amountCents Int
  currency    String      @default("NZD")
  status      QuoteStatus @default(DRAFT)
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer User      @relation("QuoteCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  invoice  Invoice?
}

// ─── Inquiries ───────────────────────────────────────────────────────────────

enum InquiryStatus {
  PENDING
  READ
  REPLIED
}

model Inquiry {
  id         String        @id @default(cuid())
  businessId String
  customerId String?
  name       String
  email      String
  subject    String
  message    String        @db.Text
  reply      String?       @db.Text
  status     InquiryStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer User?    @relation("InquiryCustomer", fields: [customerId], references: [id], onDelete: SetNull)
}

// ─── Invoices ────────────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id          String        @id @default(cuid())
  businessId  String
  quoteId     String?       @unique
  title       String
  description String?       @db.Text
  amountCents Int
  currency    String        @default("NZD")
  status      InvoiceStatus @default(DRAFT)
  dueAt       DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quote    Quote?   @relation(fields: [quoteId], references: [id])
}
